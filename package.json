{
  "name": "mediaeditor",
  "version": "0.1.0",
  "description": "Local desktop app for editing audio/video and downloading media from YouTube",
  "private": true,
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && cross-env NODE_OPTIONS=--experimental-require-module electron-builder"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "cross-env": "^10.1.0",
    "electron": "41.7.1",
    "electron-builder": "26.15.3",
    "electron-vite": "3.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@mantine/core": "9.5.0",
    "@mantine/dropzone": "9.5.0",
    "@mantine/form": "9.5.0",
    "@mantine/hooks": "9.5.0",
    "@mantine/notifications": "9.5.0",
    "@tabler/icons-react": "3.46.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
